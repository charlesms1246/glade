# Copy to .env and fill in. Never commit .env or anything in secrets/.

# --- True Markets ---------------------------------------------------------
# uat | prod. Asset ids differ per env; REST/WS base URLs are derived from this.
TM_ENV=uat
# JSON file with {"key_id": "...", <P-256 private JWK>} from dashboard.truemarkets.co
TM_ORG_KEY_FILE=./secrets/org-key.json

# --- Safety ----------------------------------------------------------------
# Glade never trades with real money: production (TM_ENV=prod) is read-only in code.
# Orders only run on UAT (paper funds) or in local simulation. Per-order cap in USD:
MAX_ORDER_USD=10000

# --- Signer ---------------------------------------------------------------
# 32 random bytes that wrap the per-user signer keys. Generate: openssl rand -base64 32
SIGNER_MASTER_KEY=base64:REPLACE_ME

# --- Database (Neon / Supabase Postgres) -----------------------------------
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/glade?sslmode=require

# --- Web app / passkeys ---------------------------------------------------
APP_ORIGIN=http://localhost:3000
# Must match the app's domain (localhost for local dev).
WEBAUTHN_RP_ID=localhost
# Signs the session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=REPLACE_ME

# --- Engine tuning --------------------------------------------------------
MIN_PERP_NOTIONAL_USD=10
DEFAULT_LEVERAGE=2
FLOOR_COOLDOWN_SEC=600
FLOOR_BAND=0.05
FUNDING_MAX_ANNUAL=0.40

# --- Kill switch: 1 = no new intents ----------------------------------------
GLADE_PAUSE_ALL=0
